 },
 "by": ["auto", "agent", "person"],
 "types": {
  "CategoryId": "enum:people|dates|money|home|papers|trips|work|other|health",
  "FamilyCategoryId": "enum:shopping|people|dates|home|papers|holidays|school|menus|other",
  "By": "enum:auto|agent|person",
  "Space": "enum:|pro",
  "DocumentRef": {"agent": "string", "file": "string"},
  "RecordRef": {"type": "enum:purchase|subscription|contract|paper|booking", "id": "string"},
  "LineRef": {"path": "string", "text": "string"},
  "Open": {"path?": "string", "section?": "string?", "record?": "RecordRef", "task?": "string", "document?": "DocumentRef", "list?": "string", "item?": "string"},
  "Item": {"id": "string", "kind": "enum:page|line|task|record|document|drive|list_item", "part": "enum:main|health", "path": "string?", "title": "string", "line": "string", "categories": "[CategoryId]", "space": "Space", "date": "string?", "source": "string", "who": "string", "noted": "string?", "open": "Open"},
  "IndexItem": {"id": "string", "kind": "enum:page|line|task|record|document", "part": "enum:main", "path": "string?", "title": "string", "line": "string", "categories": "[CategoryId]", "space": "Space", "date": "string?", "source": "string", "who": "string", "noted": "string?", "open": "Open", "fold": "string", "aliases?": "[string]", "done?": "bool"},
  "FamilyIndexItem": {"id": "string", "kind": "enum:page|list_item", "title": "string", "line": "string", "categories": "[FamilyCategoryId]", "date": "string?", "who": "string", "noted": "string?", "open": "Open", "fold": "string", "done?": "bool"},
  "DatePhrases": {"lang": "string", "phrases": "[DatePhrase]", "feasts": "map:string"},
  "DatePhrase": {"words": "string", "from": "DateEnd", "to": "DateEnd"},
  "DateEnd": {"unit": "enum:day|week|month|year|feast|weekday", "n?": "int", "edge?": "enum:start|end", "feast?": "string", "weekday?": "int"},
  "Neighbours": "map:[string]",
  "Index": {"v": "int", "version": "int", "since": "int?", "full": "bool", "lang": "string", "made": "string", "limits": {"lines": "int", "bytes": "int"}, "truncated": "bool", "online_only": "string?", "items": "[IndexItem]", "removed": "[string]", "stop": "[string]", "neighbours": "Neighbours", "dates": "DatePhrases", "kept": "[KeptShort]"},
  "FamilyIndex": {"v": "int", "version": "int", "since": "int?", "full": "bool", "lang": "string", "made": "string", "items": "[FamilyIndexItem]", "removed": "[string]", "stop": "[string]", "neighbours": "Neighbours", "dates": "DatePhrases", "kept": "[KeptShort]"},
  "KeptShort": {"id": "string", "q": "string", "title": "string"},
  "Kept": {"id": "string", "q": "string", "title": "string", "count": "int", "space": "Space", "category?": "CategoryId?"},
  "KeptList": {"kept": "[Kept]", "max": "int"},
  "SpaceChoice": {"id": "enum:all|perso|pro|family", "title": "string", "selected": "bool"},
  "CategoryLine": {"id": "CategoryId", "title": "string", "count": "int?", "hint": "string", "locked": "bool", "first?": "Item"},
  "FamilyCategoryLine": {"id": "FamilyCategoryId", "title": "string", "count": "int", "hint": "string", "locked": "bool"},
  "Card": {"kind": "enum:ask|follow|misplaced|sorted|review", "card": "any"},
  "Summary": {"v": "int", "lang": "string", "title": "string", "space": "enum:all|perso|pro", "spaces": "[SpaceChoice]", "kept": "[Kept]", "card": "Card?", "total": {"count": "int", "title": "string"}, "categories": "[CategoryLine]", "bar": {"placeholder": "string"}, "version": "int"},
  "FamilySummary": {"v": "int", "lang": "string", "title": "string", "with": "string", "kept": "[Kept]", "total": {"count": "int", "title": "string"}, "categories": "[FamilyCategoryLine]", "bar": {"placeholder": "string"}, "version": "int"},
  "Filter": {"id": "string", "title": "string", "count": "int"},
  "CategoryPage": {"v": "int", "id": "CategoryId", "title": "string", "count": "int", "space": "enum:all|perso|pro", "filters": "[Filter]", "filter": "string?", "searched": "[Searched]", "recent": "[Item]", "bar": {"placeholder": "string"}},
  "Searched": {"q": "string", "at": "string"},
  "Group": {"category": "CategoryId", "title": "string", "count": "int", "top": "[Item]"},
  "SearchAdded": {"groups": "[Group]", "counts": "map:int", "online": "OnlineDocs?"},
  "OnlineDocs": {"title": "string", "items": "[Item]"},
  "CategorizeTarget": {"path?": "string", "private?": "bool", "record?": "RecordRef", "document?": "DocumentRef", "task?": "string", "line?": "LineRef"},
  "Categorized": {"target": "CategorizeTarget", "categories": "[CategoryId]", "categories_by": "By", "before": {"categories": "[CategoryId]", "categories_by": "By"}, "learnt": "Learnt?", "undo": "string", "toast": "string?"},
  "Learnt": {"word": "string", "categories": "[CategoryId]"},
  "Undone": {"target": "CategorizeTarget", "categories": "[CategoryId]", "categories_by": "By", "unlearnt": "string?"},
  "Error": {"detail": {"code": "string", "text": "string"}}
 },
 "routes": [
  {"brick": "S1", "method": "POST", "path": "/v1/notebook/categorize", "body": "{path, private?} | {record: RecordRef} | {document: DocumentRef} | {task} | {line: LineRef}, categories: [1–2 of person_may_give]", "answer": "Categorized", "errors": {"400": "category_unknown | category_count | category_not_given (dates, health) | target_missing", "404": "not_found"}, "example": "fake-bridge/fr/categorize.json"},
  {"brick": "S1", "method": "POST", "path": "/v1/notebook/categorize/undo", "body": "{undo}", "answer": "Undone", "errors": {"404": "undo_gone"}, "example": "fake-bridge/fr/categorize-undo.json"},
  {"brick": "S1", "method": "MCP", "path": "notebook_write.category", "body": "[1–2 of agent_may_give]: the agent's choice, kept unless the person chose (categories_by person)", "answer": "the tool's text, unchanged"},
  {"brick": "S3", "method": "GET", "path": "/v1/notebook/index", "query": "since? (a version), lang?; If-None-Match: the ETag (\"v<version>\") → 304", "answer": "Index", "example": "fake-bridge/fr/index.json"},
  {"brick": "S3", "method": "GET", "path": "/v1/notebook/index?since=", "answer": "Index", "example": "fake-bridge/fr/index-since.json"},
  {"brick": "S3", "method": "GET", "path": "/v1/notebook/search (added keys)", "query": "q, lang?, space?, category?", "answer": "SearchAdded", "example": "fake-bridge/fr/search-aniv.json"},
  {"brick": "S4", "method": "GET", "path": "/v1/notebook/summary", "query": "space? (all, perso, pro), lang?", "answer": "Summary", "example": "fake-bridge/fr/summary.json"},
  {"brick": "S5", "method": "GET", "path": "/v1/notebook/summary?space=pro", "answer": "Summary", "example": "fake-bridge/fr/summary-pro.json"},
  {"brick": "S4", "method": "GET", "path": "/v1/notebook/category/{id}", "query": "space?, filter?, lang?", "answer": "CategoryPage", "example": "fake-bridge/fr/category-papers.json"},
  {"brick": "S4", "method": "GET", "path": "/v1/notebook/kept", "query": "space?", "answer": "KeptList", "example": "fake-bridge/fr/kept.json"},
  {"brick": "S4", "method": "POST", "path": "/v1/notebook/kept", "body": "{q, title?, space?, category?} (new) | {id, title} (renamed)", "answer": "KeptList", "errors": {"409": "kept_full (6 a space)"}},
  {"brick": "S4", "method": "DELETE", "path": "/v1/notebook/kept?id=", "answer": "KeptList"},
  {"brick": "S4", "method": "POST", "path": "/v1/notebook/searched", "body": "{q, category?, space?}", "answer": "204, no body"},
  {"brick": "S5", "method": "PATCH", "path": "/v1/notebook/settings", "body": "{separate_spaces: bool}", "answer": "the settings (separate_spaces added)"},
  {"brick": "S6", "method": "GET", "path": "/v1/family-agent/notebook/summary", "answer": "FamilySummary", "example": "fake-bridge/fr/family-summary.json"},
  {"brick": "S6", "method": "GET", "path": "/v1/family-agent/notebook/index", "answer": "FamilyIndex", "example": "fake-bridge/fr/family-index.json"},
  {"brick": "S6", "method": "GET|POST|DELETE", "path": "/v1/family-agent/notebook/kept", "answer": "KeptList"},
  {"brick": "S6", "method": "POST", "path": "/v1/family-agent/notebook/categorize", "body": "{page} | {list, item}, categories: [1–2 of family_may_give]", "answer": "Categorized"}
 ],
 "additive": {
  "GET /v1/notebook": ["sommaire", "settings.separate_spaces"],
  "GET /v1/notebook/pages": ["pages[].categories", "pages[].categories_by", "pages[].space"],
  "GET /v1/notebook/search": ["answers[].categories", "pages[].categories", "pages[].categories_by", "pages[].space", "tasks[].categories", "groups", "counts", "online"],
  "GET /v1/notebook/page": ["categories", "categories_by", "space", "frontmatter.categories", "frontmatter.categories_by", "frontmatter.space", "sections[].facts[].categories", "tasks[].categories", "documents[].categories", "documents[].categories_by", "records.categories", "records.items[].categories", "records.items[].categories_by", "records.archived[].categories", "records.archived[].categories_by"],
  "GET /v1/notebook/records": ["types[].categories", "types[].items[].categories", "types[].items[].categories_by", "types[].archived[].categories", "types[].archived[].categories_by"],
  "GET /v1/notebook/tasks": ["open[].categories", "done[].categories", "archived[].categories"],
  "GET /v1/notebook/documents": ["documents[].categories", "documents[].categories_by"],
  "GET /v1/notebook/settings": ["separate_spaces"],
  "GET /v1/notebook/offline": []
 },
 "page_text": "The page's own text (`text` in GET /v1/notebook/page, the file on disk) gains `categories:` (1 or 2 ids, a YAML list), `categories_by:` and, with S5, `space: pro` in its frontmatter; the 1.0 apps never read them (the comparison takes them out of `text` too)."
}
