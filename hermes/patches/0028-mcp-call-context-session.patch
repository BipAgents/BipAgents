+++ b/tools/mcp_tool.py
@@ -524,6 +524,10 @@ _CIRCUIT_BREAKER_THRESHOLD, _CIRCUIT_BREAKER_COOLDOWN_SEC = 3, 60.0
 # key (its policy for the name, even when it adopted another profile's connection);
 # ``_tool_read_only_hints`` by the connection key (the server's own tool annotations).
 _server_trust_levels: dict[Any, str] = {}
+# Servers whose config asks for the call's context (``call_context: true``): each tools/call carries the Hermes
+# session it comes from in its ``_meta`` (CALL_CONTEXT_SESSION), so a server serving several conversations of one
+# agent at once can tell them apart. Off by default: a session id is never sent to a server that did not ask.
+_call_context_servers: dict[Any, bool] = {}
 _tool_read_only_hints: dict[Any, dict[str, bool]] = {}
 # Declared per-tool costs + per-chat spend limit (``tools.mcp_tool_costs.CostPolicy``), keyed like
 # ``_server_trust_levels``: the consuming profile's policy. Absent = no costs, behaviour unchanged.
diff --git a/tools/mcp_tool_handlers.py b/tools/mcp_tool_handlers.py
index 99243c23d1534807d77a66f8209ead2e6d340a1d..bf6662c07e29f924c3264bbfdfd6be7516e5c05c 100644
--- a/tools/mcp_tool_handlers.py
+++ b/tools/mcp_tool_handlers.py
@@ -503,7 +503,22 @@ async def _track_inflight_rpc(server: Any, server_name: str, op: str, *, retry_s
             inflight.discard(task)
 
 
-async def _call_tool_racing_stdio_death(server, server_name: str, tool_name: str, args: dict, progress_callback=None):
+# The key of a tools/call's ``_meta`` naming the Hermes session the call comes from (servers with ``call_context``).
+CALL_CONTEXT_SESSION = "hermes-agent/session_id"
+
+
+def _call_context_meta(server_name: str, session_id) -> Optional[dict]:
+    """The call's ``_meta`` for a server that asked for its context (``call_context: true``), else None."""
+    from tools.mcp_tool_scope import _resolve_server_key
+    if not session_id or not isinstance(session_id, str):
+        return None
+    if _core._call_context_servers.get(_resolve_server_key(server_name)) is not True:
+        return None
+    return {CALL_CONTEXT_SESSION: session_id}
+
+
+async def _call_tool_racing_stdio_death(server, server_name: str, tool_name: str, args: dict, progress_callback=None,
+                                        meta: Optional[dict] = None):
     """``session.call_tool`` that fails fast when the stdio child is/gets dead: pre-call (a dead
     child must not hold the slot for the full timeout) and mid-call (race against
     ``_watch_stdio_children``). Both raise :class:`_StdioChildExited` for the respawn path, which
@@ -520,6 +535,8 @@ async def _call_tool_racing_stdio_death(server, server_name: str, tool_name: str
     # A progress callback makes the SDK send ``_meta.progressToken``, the spec's opt-in for
     # ``notifications/progress``; without one the server must stay silent.
     extra = {"progress_callback": progress_callback} if progress_callback is not None else {}
+    if meta:
+        extra["meta"] = meta
     _call_coro = server.session.call_tool(tool_name, arguments=args, **extra)
     _watch_children = getattr(server, "_watch_stdio_children", None)
     if not (inspect.iscoroutinefunction(_watch_children) and asyncio.iscoroutine(_call_coro)):
@@ -767,6 +784,7 @@ def _make_tool_handler(server_name: str, tool_name: str, tool_timeout: float, *,
         # Read on the agent's thread: the coroutine below runs on the MCP loop, outside this context.
         from agent.tool_progress_relay import current_tool_progress
         report = current_tool_progress()
+        meta = _call_context_meta(server_name, kwargs.get("session_id"))
 
         async def _on_progress(progress, total, message):
             if report is not None:
@@ -777,7 +795,7 @@ def _make_tool_handler(server_name: str, tool_name: str, tool_timeout: float, *,
                 server._pending_call_context = contextvars.copy_context()  # for the elicitation callback
                 try:
                     result = await _call_tool_racing_stdio_death(
-                        server, server_name, tool_name, args, _on_progress if report is not None else None)
+                        server, server_name, tool_name, args, _on_progress if report is not None else None, meta)
                 finally:
                     server._pending_call_context = None
             if getattr(server, "_mark_session_proven", None) is not None:  # round-trip done: transport healthy
