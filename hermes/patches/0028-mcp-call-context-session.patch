+++ b/tests/tools/test_mcp_call_context.py
@@ -0,0 +1,50 @@
+"""A server that asks for its calls' context (``call_context: true``) gets the Hermes session each tools/call comes
+from in the call's ``_meta``; any other server never sees it (BipAgents patch 0028)."""
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+from tools import mcp_tool as core
+from tools import mcp_tool_handlers as handlers
+
+
+def result_of(text):
+    return SimpleNamespace(content=[SimpleNamespace(type="text", text=text)], structuredContent=None, isError=False)
+
+
+@pytest.fixture()
+def calls(monkeypatch):
+    monkeypatch.setattr("tools.mcp_tool_scope._resolve_server_key", lambda name: name)
+    yield
+    core._call_context_servers.clear()
+
+
+def test_a_server_that_asked_gets_the_calls_session(calls):
+    core._call_context_servers["bipagents"] = True
+    assert handlers._call_context_meta("bipagents", "api_s1") == {handlers.CALL_CONTEXT_SESSION: "api_s1"}
+    assert handlers._call_context_meta("bipagents", None) is None
+    assert handlers._call_context_meta("bipagents", "") is None
+
+
+def test_no_other_server_ever_sees_it(calls):
+    core._call_context_servers["bipagents"] = False
+    assert handlers._call_context_meta("bipagents", "api_s1") is None
+    assert handlers._call_context_meta("weather", "api_s1") is None
+
+
+def test_the_meta_reaches_the_sdks_call(calls):
+    server = SimpleNamespace(session=SimpleNamespace(call_tool=None))
+    sent = {}
+
+    async def call_tool(name, arguments=None, **kwargs):
+        sent.update(kwargs)
+        return result_of("ok")
+
+    server.session.call_tool = call_tool
+    asyncio.run(handlers._call_tool_racing_stdio_death(server, "bipagents", "create_page", {}, None,
+                                                       {handlers.CALL_CONTEXT_SESSION: "api_s2"}))
+    assert sent == {"meta": {handlers.CALL_CONTEXT_SESSION: "api_s2"}}
+    sent.clear()
+    asyncio.run(handlers._call_tool_racing_stdio_death(server, "weather", "now", {}, None, None))
+    assert "meta" not in sent
