index 0000000000000000000000000000000000000000..3a78bae2d380c205b4fe585c8bfc6dc9753a2cd3
--- /dev/null
+++ b/tests/tools/test_mcp_call_context_parallel.py
@@ -0,0 +1,154 @@
+"""Calls to a server that asks for its calls' context (``call_context: true``) are serialised per Hermes session, not
+per server: one session's call blocked for minutes (a card waiting for its person) never holds up another session's
+calls to the same server. Any other server keeps one call at a time; the server's own RPCs (tools/list, keepalive)
+still never overlap a call (BipAgents patch 0029)."""
+import asyncio
+import contextvars
+import json
+import threading
+import time
+from unittest.mock import MagicMock
+
+import pytest
+
+pytest.importorskip("mcp.client.auth.oauth2")
+from tools import mcp_tool as core
+from tools import mcp_tool_loop as loop
+from tools.mcp_tool_handlers import _make_tool_handler
+
+
+def result_of(text):
+    result = MagicMock()
+    result.is_error = False
+    block = MagicMock()
+    block.text = text
+    result.content = [block]
+    result.structured_content = None
+    return result
+
+
+class Server:
+    """A connected server whose ``waits`` sessions' calls block until released."""
+
+    def __init__(self, name, call_context):
+        self.name, self.release, self.started = name, threading.Event(), threading.Event()
+        server = MagicMock()
+        server.name = name
+        server._rpc_lock = core.MCPServerTask(name)._rpc_lock  # the real one
+        server._inflight_tasks = set()
+        server._session_call_contexts = {}
+        server._is_recycled_stdio.return_value = False
+        server._ready.is_set.return_value = True
+        server.session = MagicMock()
+        release, started = self.release, self.started
+
+        async def call_tool(tool, arguments=None, **kwargs):
+            if (arguments or {}).get("wait"):
+                started.set()
+                while not release.is_set():
+                    await asyncio.sleep(0.02)
+            return result_of(f"done {tool}")
+
+        server.session.call_tool = call_tool
+        self.server = server
+        core._servers[name] = server
+        core._server_error_counts.pop(name, None)
+        core._call_context_servers[name] = call_context
+
+    def close(self):
+        self.release.set()
+        core._servers.pop(self.name, None)
+        core._call_context_servers.pop(self.name, None)
+
+
+@pytest.fixture()
+def place(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr("tools.mcp_tool_scope._resolve_server_key", lambda name: name)
+    loop._ensure_mcp_loop()
+    made = []
+
+    def make(name, call_context):
+        made.append(Server(name, call_context))
+        return made[-1]
+
+    yield make
+    for server in made:
+        server.close()
+
+
+def call(name, tool, session, args=None):
+    """The call on a thread of its own: (thread, box) — box["text"] once it answered."""
+    box = {}
+    handler = _make_tool_handler(name, tool, 30.0)
+    thread = threading.Thread(target=lambda: box.update(text=handler(dict(args or {}), session_id=session)), daemon=True)
+    thread.start()
+    return thread, box
+
+
+def test_another_sessions_call_goes_through_while_one_waits(place):
+    server = place("bipagents_vault", call_context=True)
+    blocked, _ = call(server.name, "ask_to_send", "s_task", {"wait": True})
+    assert server.started.wait(5)
+    person, box = call(server.name, "vault_login", "s_person")
+    person.join(5)
+    assert json.loads(box.get("text", "{}")).get("result") == "done vault_login", "the person's call waited for the task's"
+    assert blocked.is_alive()
+    server.release.set()
+    blocked.join(5)
+
+
+def test_one_sessions_calls_still_go_one_at_a_time(place):
+    server = place("bipagents", call_context=True)
+    first, _ = call(server.name, "ask", "s1", {"wait": True})
+    assert server.started.wait(5)
+    second, box = call(server.name, "other", "s1")
+    second.join(0.5)
+    assert second.is_alive() and "text" not in box, "two calls of one session at once"
+    server.release.set()
+    second.join(5)
+    assert json.loads(box["text"]).get("result") == "done other"
+
+
+def test_any_other_server_keeps_one_call_at_a_time(place):
+    server = place("weather", call_context=False)
+    first, _ = call(server.name, "slow", "s1", {"wait": True})
+    assert server.started.wait(5)
+    second, box = call(server.name, "now", "s2")
+    second.join(0.5)
+    assert second.is_alive(), "a server that never asked for it ran two calls at once"
+    server.release.set()
+    second.join(5)
+
+
+def test_the_servers_own_rpcs_never_overlap_a_call(place):
+    server = place("bipagents_pay", call_context=True)
+    first, _ = call(server.name, "pay", "s1", {"wait": True})
+    assert server.started.wait(5)
+    lock = server.server._rpc_lock
+    assert lock.locked(), "a call in flight: the server looks idle (keepalive, recycle)"
+
+    async def exclusive():
+        async with lock:
+            return time.monotonic()
+
+    future = asyncio.run_coroutine_threadsafe(exclusive(), core._mcp_loop)
+    time.sleep(0.3)
+    assert not future.done(), "tools/list ran during a call"
+    server.release.set()
+    assert future.result(5)
+    first.join(5)
+
+
+def test_an_elicitation_during_several_sessions_calls_is_never_shown_in_the_wrong_conversation():
+    server = core.MCPServerTask("bipagents_vault")
+    assert server._elicitation_call_context() is None
+    one, two = contextvars.copy_context(), contextvars.copy_context()
+    server._session_call_contexts["a"] = one
+    assert server._elicitation_call_context() is one
+    server._session_call_contexts["b"] = two
+    with pytest.raises(RuntimeError):  # names no session: the handler declines it
+        server._elicitation_call_context()
+    # the server said the call's session back in the elicitation's _meta (the bridge's pay and vault servers do)
+    assert server._elicitation_call_context({"hermes-agent/session_id": "b"}) is two
+    assert server._elicitation_call_context({"hermes-agent/session_id": "a"}) is one
