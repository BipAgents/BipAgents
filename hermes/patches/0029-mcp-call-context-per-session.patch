 # ---- Server task -- each MCP server lives in one long-lived asyncio Task ----
 
+class _RpcLock:
+    """The server's RPC lock: ``async with`` is exclusive (tools/list, keepalive, refresh, a call without a session),
+    as an ``asyncio.Lock``. ``for_session(id)`` is a tools/call of one Hermes session on a server whose config says
+    ``call_context: true``: one at a time per session, sessions side by side (the SDK tells requests apart by their
+    JSON-RPC id on stdio and HTTP alike), never during an exclusive RPC. An exclusive RPC waits for the calls in
+    flight without holding new sessions' calls back: a call blocked for minutes on its person never stops the
+    others. ``locked()`` is True while anything holds it, so recycling and keepalive see a busy server."""
+
+    def __init__(self):
+        self._lock = asyncio.Lock()
+        self._shared = 0
+        self._idle = asyncio.Event()
+        self._idle.set()
+        self._sessions: dict[str, list] = {}  # session -> [its lock, how many hold or wait for it]
+
+    def locked(self) -> bool:
+        return self._lock.locked() or self._shared > 0
+
+    async def __aenter__(self):
+        while True:
+            await self._idle.wait()
+            await self._lock.acquire()
+            if self._shared == 0:
+                return self
+            self._lock.release()
+
+    async def __aexit__(self, *exc):
+        self._lock.release()
+
+    @contextlib.asynccontextmanager
+    async def for_session(self, session: str):
+        entry = self._sessions.setdefault(session, [asyncio.Lock(), 0])
+        entry[1] += 1
+        try:
+            async with entry[0]:
+                async with self._lock:  # never during an exclusive RPC
+                    self._shared += 1
+                    self._idle.clear()
+                try:
+                    yield self
+                finally:
+                    self._shared -= 1
+                    if self._shared == 0:
+                        self._idle.set()
+        finally:
+            entry[1] -= 1
+            if entry[1] == 0:
+                self._sessions.pop(session, None)
+
+
 class MCPServerTask(MCPServerRunMixin, MCPServerTransportMixin, MCPServerHealthMixin):
     """One MCP server connection in one long-lived asyncio Task (the transport's anyio cancel
     scopes must enter/exit in the same Task). Run state machine, transport bring-up and
