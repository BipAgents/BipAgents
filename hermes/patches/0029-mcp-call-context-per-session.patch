+        self._session_call_contexts: dict = {}
         self._lifecycle_started_at = self._last_tool_call_at = time.monotonic()
         self._idle_timeout_seconds = self._max_lifetime_seconds = self._recycled_reason = None
         # Handshake InitializeResult: the server's REAL advertised capabilities.
@@ -444,6 +499,21 @@ class MCPServerTask(MCPServerRunMixin, MCPServerTransportMixin, MCPServerHealthM
         # Latched when ``ping`` returns -32601; keepalives then use list_tools. Reset per connect.
         self._ping_unsupported: bool = False
 
+    def _elicitation_call_context(self, meta: Optional[dict] = None) -> Optional[contextvars.Context]:
+        """The snapshot of the call an elicitation comes from: the session its ``_meta`` names (a call_context server
+        says it back), else the only call in flight. Several sessions' calls and no session named: it can't be told
+        whose it is, so the elicitation is declined rather than shown in the wrong conversation."""
+        if self._pending_call_context is not None:
+            return self._pending_call_context
+        from tools.mcp_tool_handlers import CALL_CONTEXT_SESSION
+        session = meta.get(CALL_CONTEXT_SESSION) if isinstance(meta, dict) else None
+        if session in self._session_call_contexts:
+            return self._session_call_contexts[session]
+        contexts = list(self._session_call_contexts.values())
+        if len(contexts) > 1:
+            raise RuntimeError(f"MCP server '{self.name}': an elicitation during several sessions' calls names none")
+        return contexts[0] if contexts else None
+
     # Content types a real Streamable-HTTP endpoint may return on the initial POST/GET;
